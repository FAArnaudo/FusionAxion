<Window x:Class="FusionAxion.Views.PanelFusion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FusionAxion"
        xmlns:viewModel="clr-namespace:FusionAxion.ViewModels"
        mc:Ignorable="d"
        WindowStyle="None"
        Title="Controlador de Surtidores" Height="478" Width="780"
        ResizeMode="CanMinimize" MouseDown="Window_MouseDown">

    <Window.DataContext>
        <viewModel:PanelFusionViewModel></viewModel:PanelFusionViewModel>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"></BooleanToVisibilityConverter>
    </Window.Resources>

    <Window.Visibility>
        <Binding Path="IsViewVisible" Mode="TwoWay" Converter="{StaticResource BooleanToVisibility}"></Binding>
    </Window.Visibility>

    <Grid x:Name="GMain">
        <!--#region GRID TOP-->
        <Grid Width="780" Height="30" Background="#2C3E50"
              VerticalAlignment="Top">
            <!--#region BUTTONS-->
            <Button Grid.Row="0" Grid.Column="2" Name="BtnCerrar"
                    Width="35" Height="30"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#1B1448" BorderBrush="#007ED6"
                    Style="{DynamicResource ButtonStyle}" Command="{Binding CloseCommand}">
                <TextBlock Text="X" Foreground="White" FontSize="20"></TextBlock>
            </Button>
            <Button Grid.Row="0" Grid.Column="2" Name="BtnMinimizar"
                    Width="35" Height="30"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,35,0"
                    Background="#1B1448" BorderBrush="#007ED6"
                    Style="{DynamicResource ButtonStyle}" Click="BtnMinimizar_Click">
                <TextBlock Text="-" Foreground="White" FontSize="20"></TextBlock>
            </Button>
            <!--#endregion-->
            <!--#region TITLE-->
            <TextBlock Text="InterAxion"
                           Height="30" Width="94"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="44,0,0,0"
                           FontSize="20" Foreground="White"></TextBlock>
            <!--#endregion-->
            <!--#region IMAGE-->
            <!--#endregion-->
        </Grid>
        <!--#endregion-->
        <!--#region GRID PANEL-->
        <Grid Width="140" Height="448" Background="#34495E"
              HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <StackPanel x:Name="SPPanel">
                <!--#region TEXT BLOCK IP-->
                <TextBlock Width="120" Height="25" Foreground="#ECF0F1"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           Text="{Binding CurrentData.IP}"
                           FontSize="18" TextAlignment="Center"></TextBlock>
                <!--#endregion-->
                <!--#region BUTTON CAMBIAR CONFIGURACION-->
                <Button Name="BtnCambiarConfig"
                        Width="120" Height="50"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"
                        Background="#34495E" BorderBrush="#5D6D7E"
                        Style="{DynamicResource ButtonStyle}"
                        Command="{Binding CambiarConfigCommand}">
                    <TextBlock Foreground="#ECF0F1" FontSize="15">
                        Cambiar
                        <LineBreak/>
                        Configuración
                    </TextBlock>
                </Button>
                <!--#endregion-->
                <!--#region BUTTON DESPACHOS-->
                <Button Name="Despachos"
                        Width="120" Height="50"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"
                        Background="#34495E" BorderBrush="#5D6D7E"
                        Style="{DynamicResource ButtonStyle}"
                        Command="{Binding}">
                    <TextBlock Foreground="#ECF0F1" FontSize="15">
                        Despachos
                    </TextBlock>
                </Button>
                <!--#endregion-->
                <!--#region BUTTON SURTIDORES-->
                <Button Name="Surtidores"
                        Width="120" Height="50"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"
                        Background="#34495E" BorderBrush="#5D6D7E"
                        Style="{DynamicResource ButtonStyle}"
                        Command="{Binding}">
                    <TextBlock Foreground="#ECF0F1" FontSize="15">
                        Surtidores
                    </TextBlock>
                </Button>
                <!--#endregion-->
                <!--#region BUTTON TANQUES-->
                <Button Name="Tanques"
                        Width="120" Height="50"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"
                        Background="#34495E" BorderBrush="#5D6D7E"
                        Style="{DynamicResource ButtonStyle}"
                        Command="{Binding}">
                    <TextBlock Foreground="#ECF0F1" FontSize="15">
                        Tanques
                    </TextBlock>
                </Button>
                <!--#endregion-->
                <!--#region BUTTON PRODUCTOS-->
                <Button Name="Productos"
                        Width="120" Height="50"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"
                        Background="#34495E" BorderBrush="#5D6D7E"
                        Style="{DynamicResource ButtonStyle}"
                        Command="{Binding}">
                    <TextBlock Foreground="#ECF0F1" FontSize="15">
                        Productos
                    </TextBlock>
                </Button>
                <!--#endregion-->
                <!--#region BUTTON VERIFICAR CONEXION-->
                <Button Name="BtnVerifyConfig"
                    Width="120" Height="50"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"
                    Background="#34495E" BorderBrush="#5D6D7E"
                    Style="{DynamicResource ButtonStyle}">
                    <TextBlock Foreground="#ECF0F1" FontSize="15">
                        Verificar
                        <LineBreak/>
                        Conexión
                    </TextBlock>
                </Button>
                <!--#endregion-->
                <!--#region LABEL STATE-->
                <Label x:Name="LStatus"
                   Width="{Binding LabelConnection.Width}" Height="{Binding LabelConnection.Height}"
                   Background="{Binding LabelConnection.Background}" Margin="0,8,0,0"
                   Content="{Binding LabelConnection.Label}" Foreground="#ECF0F1" FontSize="15"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                <!--#endregion-->
            </StackPanel>
        </Grid>
        <!--#endregion-->
        <!--#region GRID CONTENEDOR-->
        <Grid x:Name="GContainer"
              Height="448" Width="640"
              VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <!--#region SURTIDORES-->
            <ItemsControl ItemsSource="{Binding SurtidoresButton}"
                          Height="450"
                          VerticalAlignment="Bottom" Background="#91a6ab">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="4" Columns="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Command="{Binding Command}"
                                CommandParameter="{Binding }"
                                Height="{Binding Height}" Width="{Binding Width}"
                                Background="{Binding Background}" Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!--#endregion-->
        </Grid>
        <!--#endregion-->
    </Grid>
</Window>
