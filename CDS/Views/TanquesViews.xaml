<Window x:Class="CDS.Views.TanquesViews"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CDS.Views"
        mc:Ignorable="d"
        Icon="/Images/LogoSurtidor.ico"
        Title="Vista de Tanques" Height="460" Width="650">
    <Border Background="#D6E2E8">
        <Grid x:Name="G_Tanques">
            <StackPanel x:Name="SP_Tanques"
                        Width="642" Height="429"
                        VerticalAlignment="Top">
                <!--#region DATA GRID-->
                <DataGrid x:Name="DG_Tanques"
                          Width="602" Height="340"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"
                          CanUserResizeColumns="False" CanUserDeleteRows="False"
                          HorizontalGridLinesBrush="#D6E2E8"
                          IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° de Tanque" Width="130"
                                        Binding="{Binding id_tanque}"/>
                        <DataGridTextColumn Header="Volumen Actual" Width="130"
                                        Binding="{Binding volumen_actual}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Volumen Total" Width="130"
                                        Binding="{Binding capacidad_maxima}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Ultima Actualización" Width="130"
                                        Binding="{Binding actualizado}"></DataGridTextColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="Black"></Setter>
                            <Setter Property="Background" Value="#9db0f5"></Setter>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
                <!--#endregion-->
                <!--#region BUTTON CLOSE-->
                <Button Name="BtnClose"
                        Width="160" Height="35"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,20,20,10"
                        Background="#007ED6" BorderBrush="#007ED6"
                        Style="{DynamicResource ButtonStyle}" Click="BtnClose_Click">
                    <TextBlock Text="Cerrar" Foreground="White" FontSize="20"></TextBlock>
                </Button>
                <!--#endregion-->
            </StackPanel>
        </Grid>
    </Border>
</Window>
