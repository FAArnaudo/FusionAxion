<Window x:Class="CDS.Views.CierresViews"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CDS.Views"
        mc:Ignorable="d"
        Icon="/Images/LogoSurtidor.ico"
        Title="Vista de Cierres de Turno" Height="460" Width="950">
    <Border Background="#D6E2E8">
        <Grid x:Name="G_CierreDeTurno">
            <StackPanel x:Name="SP_CierreDeTurno"
                        Width="942" Height="429"
                        VerticalAlignment="Top">
                <!--#region DATA GRID-->
                <DataGrid x:Name="DG_CierreDeTurno"
                          Width="902" Height="340"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"
                          CanUserResizeColumns="False" CanUserDeleteRows="False"
                          HorizontalGridLinesBrush="#D6E2E8"
                          IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID Cierre" Width="60" IsReadOnly="True"
                                        Binding="{Binding id}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Fecha" Width="150"
                                        Binding="{Binding fecha}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Monto Contado" Width="130"
                                        Binding="{Binding monto_contado}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Volumen Contado" Width="130"
                                        Binding="{Binding volumen_contado}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Monto YPF Ruta" Width="140"
                                        Binding="{Binding monto_YPFruta}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Volumen YPF Ruta" Width="140"
                                        Binding="{Binding volumen_YPFruta}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Estado" Width="140"
                                        Binding="{Binding state}"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!--#endregion-->
                <!--#region BUTTON CLOSE-->
                <Button Name="BtnClose"
                        Width="160" Height="35"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,20,20,10"
                        Background="#007ED6" BorderBrush="#007ED6"
                        Style="{DynamicResource ButtonStyle}" Click="BtnClose_Click">
                    <TextBlock Text="Cerrar" Foreground="White" FontSize="20"></TextBlock>
                </Button>
                <!--#endregion-->
            </StackPanel>
        </Grid>
    </Border>
</Window>
