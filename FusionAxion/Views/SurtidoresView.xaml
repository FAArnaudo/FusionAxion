<Window x:Class="FusionAxion.Views.SurtidoresView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FusionAxion.Views"
        xmlns:viewModel="clr-namespace:FusionAxion.ViewModels"
        mc:Ignorable="d"
        Title="Surtidores" Height="650" Width="450"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Images/fuel_pump.ico">
    
    <Window.DataContext>
        <viewModel:SurtidoresViewModel></viewModel:SurtidoresViewModel>
    </Window.DataContext>

    <Grid Background="#2E3A3F">
        <DataGrid ItemsSource="{Binding Datos}" AutoGenerateColumns="False"
              Margin="5"
              Background="#1F272B"
              Foreground="White"
              GridLinesVisibility="All"
              HorizontalGridLinesBrush="#707B7F"
              VerticalGridLinesBrush="#707B7F"
              HeadersVisibility="All"
              ColumnHeaderHeight="30"
              RowBackground="#1F272B"
              AlternatingRowBackground="#273034">
            <!-- Declaración directa del estilo del encabezado -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#39444A" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Surtidor" Binding="{Binding Surtidor}" Width="80"/>
                <DataGridTextColumn Header="Manguera" Binding="{Binding Manguera}" Width="80"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="130"/>
                <DataGridTextColumn Header="Precio Unitario" Binding="{Binding PPU}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
